<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SHADOW REIGN | The Final Stand</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-base: #07070a;
      --bg-card: #0f1015;
      --crimson: #dc2626;
      --crimson-glow: rgba(220, 38, 38, 0.4);
      --discord: #5865f2;
      --discord-glow: rgba(88, 101, 242, 0.4);
      --gold: #f59e0b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border: rgba(220, 38, 38, 0.25);
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
      line-height: 1.6;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      background: rgba(7, 7, 10, 0.85);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .logo {
      font-family: 'Cinzel', serif;
      font-size: 1.3rem;
      font-weight: 900;
      letter-spacing: 2px;
      color: #fff;
      text-transform: uppercase;
    }
    .logo span {
      color: var(--crimson);
      text-shadow: 0 0 10px var(--crimson-glow);
    }
    .status-badge {
      font-size: 0.75rem;
      font-weight: 700;
      color: #22c55e;
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.3);
      padding: 4px 10px;
      border-radius: 99px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .status-dot {
      width: 7px;
      height: 7px;
      background: #22c55e;
      border-radius: 50%;
      box-shadow: 0 0 8px #22c55e;
    }
    .hero {
      padding: 44px 20px 32px;
      text-align: center;
      background: radial-gradient(circle at 50% 10%, rgba(220, 38, 38, 0.15) 0%, transparent 70%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }
    .hero-tag {
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--crimson);
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .hero h1 {
      font-family: 'Cinzel', serif;
      font-size: 2.2rem;
      font-weight: 900;
      line-height: 1.15;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 14px;
    }
    .hero p {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-bottom: 24px;
    }
    .btn-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .cta-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: var(--discord);
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 15px 20px;
      border-radius: 12px;
      box-shadow: 0 8px 25px var(--discord-glow);
    }
    .value-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.35);
      color: var(--gold);
      text-decoration: none;
      font-weight: 700;
      font-size: 0.9rem;
      padding: 14px 20px;
      border-radius: 12px;
    }
    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      padding: 24px 20px;
    }
    .stat-card {
      background: var(--bg-card);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      padding: 14px 10px;
      text-align: center;
    }
    .stat-val {
      font-family: 'Cinzel', serif;
      font-size: 1.25rem;
      font-weight: 900;
      color: var(--crimson);
    }
    .stat-lbl {
      font-size: 0.7rem;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-top: 4px;
    }
    .section-title {
      font-family: 'Cinzel', serif;
      font-size: 1.2rem;
      font-weight: 800;
      padding: 16px 20px 8px;
      text-transform: uppercase;
      letter-spacing: 1px;
      border-left: 4px solid var(--crimson);
      margin: 10px 20px 0;
    }
    .features {
      padding: 14px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .feat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px;
    }
    .feat-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
    }
    .feat-badge {
      background: rgba(220, 38, 38, 0.15);
      color: var(--crimson);
      font-size: 0.7rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 6px;
      text-transform: uppercase;
    }
    .feat-title {
      font-weight: 700;
      font-size: 1rem;
    }
    .feat-desc {
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    footer {
      text-align: center;
      padding: 24px 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      margin-top: 20px;
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    .studio-plug {
      display: inline-block;
      margin-top: 8px;
      color: #38bdf8;
      text-decoration: none;
      font-weight: 600;
    }
  </style>
</head>
<body>

